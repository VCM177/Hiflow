PORT=4000

# Neon (serverless Postgres) — copy the pooled connection string from the Neon console
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/hiflow?sslmode=verify-full

# Upstash (serverless Redis)
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
