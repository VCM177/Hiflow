PORT=4000

# Origin of the web app allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Neon (serverless Postgres) — copy the connection string from the Neon console
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/hiflow?sslmode=verify-full

# Upstash (serverless Redis) — needed from the reports/dashboard cache onward
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Where uploaded CV files are written, relative to apps/api (default: uploads)
# UPLOAD_DIR=uploads

# Password given to the demo accounts by the seed scripts
# SEED_DEFAULT_PASSWORD=change-me
