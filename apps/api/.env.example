PORT=4000

# Origins allowed by CORS: comma-separated, exact (never "*", no trailing slash).
# Unset means http://localhost:3000 locally and no cross-origin access in
# production, where the web app proxies /api to this server on its own domain.
WEB_ORIGIN=http://localhost:3000

# Cloudflare Turnstile (captcha on the public application form): the SECRET key
# only; the site key belongs to the web app. Required in production. Unset
# elsewhere means the captcha is not checked. Cloudflare's own test secrets need
# no account: 1x0000000000000000000000000000000AA always passes, and
# 2x0000000000000000000000000000000AA always fails.
# TURNSTILE_SECRET=

# Confirmation emails to candidates: "outbox" (default: nothing is sent, messages
# are only kept in memory) or "resend" (required in production). Resend only
# delivers to arbitrary addresses once you verify a sending domain; until then
# it accepts only the account owner's address.
# MAIL_DRIVER=outbox
# RESEND_API_KEY=
# MAIL_FROM=Hiflow <no-reply@your-domain.example>

# Public address of this API (e.g. the Cloud Run URL). Listed as a server in the
# Swagger document at /docs, next to http://localhost:4000 and the /api proxy.
# PUBLIC_API_URL=https://hiflow-api-xxxx.a.run.app

# Shared secret the web app's proxy sends in the x-hiflow-proxy-secret header.
# When set, every request without it gets 404, so the public API address cannot
# be used to bypass the proxy. Required in production.
# PROXY_SECRET=long-random-value

# Neon (serverless Postgres) — copy the connection string from the Neon console
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/hiflow?sslmode=verify-full

# Upstash (serverless Redis): shared rate-limit counters across containers.
# Required when NODE_ENV=production; without it counting stays per process.
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

# Proxies in front of the API whose X-Forwarded-For entries are believed
# (a number). Required in production; leave unset locally. Too low and every
# caller looks like the proxy, too high and clients can spoof their address.
# TRUST_PROXY=2

# Test and tuning knobs (defaults are fine): "memory" forces per-process
# counting even when REDIS_URL is set; the scale multiplies every rate limit.
# THROTTLE_STORAGE=memory
# THROTTLE_LIMIT_SCALE=1

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Where CV files are kept: "local" (default, development and tests only: a
# container's disk is wiped on restart) or "supabase" (required in production).
# STORAGE_DRIVER=local
# Local driver: folder for CV files, relative to apps/api
# UPLOAD_DIR=uploads
# Supabase driver: a PRIVATE bucket (files are only reachable through signed
# addresses that expire after 60 seconds). Use the service role key, server side only.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=hiflow-cvs

# Password given to the demo accounts by the seed scripts
# SEED_DEFAULT_PASSWORD=change-me
