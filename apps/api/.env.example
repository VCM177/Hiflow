PORT=4000

# Origin of the web app allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Neon (serverless Postgres) — copy the connection string from the Neon console
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/hiflow?sslmode=verify-full

# Upstash (serverless Redis): shared rate-limit counters across containers.
# Required when NODE_ENV=production; without it counting stays per process.
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

# Proxies in front of the API whose X-Forwarded-For entries are believed
# (a number). Required in production; leave unset locally. Too low and every
# caller looks like the proxy, too high and clients can spoof their address.
# TRUST_PROXY=2

# Test and tuning knobs (defaults are fine): "memory" forces per-process
# counting even when REDIS_URL is set; the scale multiplies every rate limit.
# THROTTLE_STORAGE=memory
# THROTTLE_LIMIT_SCALE=1

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Where uploaded CV files are written, relative to apps/api (default: uploads)
# UPLOAD_DIR=uploads

# Password given to the demo accounts by the seed scripts
# SEED_DEFAULT_PASSWORD=change-me
