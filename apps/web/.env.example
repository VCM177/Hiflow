# Server-side only. The browser never talks to the API directly: it calls this
# app's /api/* routes, and the route handler forwards them to API_ORIGIN.
API_ORIGIN=http://localhost:4000

# Server-side only secret. When the API sets PROXY_SECRET, it answers 404 to any
# request without a matching x-hiflow-proxy-secret header; the proxy adds it.
# Use the same value as PROXY_SECRET in apps/api/.env. Leave unset in development.
# PROXY_SECRET=long-random-value

# Public by design (Cloudflare Turnstile site key, not the secret). Cloudflare's
# test key 1x00000000000000000000AA always passes and needs no account.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-side. The public address of this web app, without a trailing slash, for the sitemap,
# canonical addresses and the job data search engines read. Required in production.
# SITE_URL=https://tuyendung.example.com
